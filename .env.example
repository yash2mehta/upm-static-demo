# Copy these into your host's environment variables. Never commit real values.
#   Netlify:    Site configuration > Environment variables
#   Cloudflare: Workers & Pages > (project) > Settings > Variables and Secrets

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Username/password logins, comma-separated "username:password" pairs.
# Leave empty to hide the username/password form.
LOGIN_USERS=demo:change-me

# Google sign-in. Leave GOOGLE_CLIENT_ID empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=stratagile.com

# Only these Google accounts may sign in (comma-separated).
# Set to * to allow everyone in GOOGLE_ALLOWED_DOMAIN.
GOOGLE_ALLOWED_EMAILS=someone@stratagile.com,someone.else@stratagile.com
